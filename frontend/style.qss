/* ==================== TABLES ==================== */
QTableWidget {
    background-color: #121212;
    alternate-background-color: #1F1F1F;
    gridline-color: #3A3A3A;
    border: 1px solid #3A3A3A;
}

QTableWidget::item {
    padding: 8px;
    color: #E5E7EB;
    font-size: 16pt;
}

QTableWidget::item:selected {
    background-color: ACCENT_COLOR;
    color: #121212;
}

QTableWidget::item:selected:active {
    background-color: ACCENT_COLOR;
    color: #121212;
}

QHeaderView::section {
    background-color: #1F1F1F;
    color: #E5E7EB;
    padding: 12px;
    border: none;
    border-bottom: 2px solid ACCENT_COLOR;
    font-weight: bold;
    font-size: 14pt;
}

QTableView#tblData {
    font-size: 16pt;
}

QTableView#tblData::item {
    padding: 8px;
    min-height: 50px;
}

QTableView#tblData::item:selected {
    background-color: ACCENT_COLOR;
    color: #121212;
}

QTableView#tblData::item:selected:active {
    background-color: ACCENT_COLOR;
    color: #121212;
}

QTableView#tblData QHeaderView::section {
    font-size: 16pt;
    padding: 8px;
    min-height: 45px;
}

QTableView#tblData QScrollBar:vertical {
    width: 35px;
    background: transparent;
}

QTableView#tblData QScrollBar::handle:vertical {
    background: rgba(200,200,200,0.9);
    min-height: 50px;
    border-radius: 8px;
}

QTableView#tblData QScrollBar::add-line:vertical,
QTableView#tblData QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ==================== SCROLL BARS ==================== */
QScrollBar:vertical {
    background-color: #121212;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3A3A3A;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: ACCENT_COLOR;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    border: none;
    width: 0px;
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #121212;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #3A3A3A;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: ACCENT_COLOR;
}

/* ==================== MENU BARS & MENUS ==================== */
QMenuBar {
    background-color: #1F1F1F;
    color: #E5E7EB;
    border-bottom: 1px solid #3A3A3A;
    padding: 8px;
    font-size: 14pt;
}

QMenuBar:disabled {
    background-color: #1A1A1A;
    color: #6B7280;
    border-bottom: 1px solid #2A2A2A;
}

QMenuBar::item:selected {
    background-color: ACCENT_COLOR;
    color: #121212;
    border-radius: 4px;
}

QMenuBar::item:disabled {
    background-color: transparent;
    color: #6B7280;
}

QMenuBar::item {
    padding: 10px 15px;
}

QMenu {
    background-color: #1F1F1F;
    color: #E5E7EB;
    border: 1px solid #3A3A3A;
    padding: 8px 0px;
    font-size: 18pt;
}

QMenu:disabled {
    background-color: #1A1A1A;
    color: #6B7280;
    border: 1px solid #2A2A2A;
}

QMenu::item:selected {
    background-color: ACCENT_COLOR;
    color: #121212;
    padding: 12px 16px;
}

QMenu::item:disabled {
    background-color: transparent;
    color: #6B7280;
}

QMenu::item {
    padding: 12px 25px;
    min-height: 45px;
}

/* ==================== STATUS BAR ==================== */
QStatusBar {
    background-color: #1F1F1F;
    color: #E5E7EB;
    border-top: 1px solid #3A3A3A;
    padding: 8px 12px;
    font-size: 12pt;
}

/* ==================== DIALOGS ==================== */
QDialog {
    background-color: #121212;
}

/* ==================== OVERRIDE DIALOG ==================== */
QLabel#label {
    font-weight: bold;
    font-size: 14pt;
}

QLabel#lblWarning {
    color: #ff6b6b;
    background-color: #3a1a1a;
    padding: 8px;
    border-radius: 4px;
    font-weight: bold;
}

QDialog#OverrideDialog QLabel#label {
    font-size: 24pt;
    padding: 10px 0;
}

QDialog#OverrideDialog QLabel#lblWarning {
    font-size: 19pt;
    padding: 16px;
    border-radius: 8px;
}

QDialog#OverrideDialog QLabel#lblInstruction {
    font-size: 18pt;
    color: #f0dede;
    padding: 10px 0 6px 0;
}

QDialog#OverrideDialog QCheckBox {
    font-size: 19pt;
    padding: 10px 0;
}

QDialog#OverrideDialog QLabel#lblOverrideStatus {
    font-size: 18pt;
    padding: 8px 0;
}

QDialog#OverrideDialog QDialogButtonBox QPushButton {
    min-width: 150px;
    min-height: 64px;
    font-size: 18pt;
}

/* QCheckBox#chkEnableOverride {
    font-size: 12pt;
} */

QLabel#lblOverrideStatus[status="enabled"] {
    color: #10B981;
}

QLabel#lblOverrideStatus[status="disabled"] {
    color: #EF4444;
}

/* ==================== TABS ==================== */
QTabWidget::pane {
    border: 1px solid #3A3A3A;
}

QTabBar::tab {
    background-color: #1F1F1F;
    color: #E5E7EB;
    padding: 12px 16px;
    margin-right: 8px;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #121212;
    border-bottom: 2px solid ACCENT_COLOR;
}

QTabBar::tab:hover {
    background-color: #2A2A2A;
    border-bottom: 2px solid ACCENT_COLOR;
}

/* ==================== FRONT PAGE BUTTONS ==================== */
QPushButton#btnDiagnostic,
QPushButton#btnAnalysis,
QPushButton#btnShot {
    font-size: 30pt;
}

/* ==================== PROGRESS BAR ==================== */
QProgressBar {
    background-color: #1F1F1F;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    color: #E5E7EB;
    min-height: 48px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: ACCENT_COLOR;
    border-radius: 4px;
}

/* ==================== TOOLTIPS ==================== */
QToolTip {
    background-color: #1F1F1F;
    color: #E5E7EB;
    border: 1px solid #3A3A3A;
    padding: 8px;
    border-radius: 4px;
}

/* ==================== TEXT INPUTS ==================== */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1F1F1F;
    color: #E5E7EB;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 12px;
    font-size: 14pt;
    min-height: 48px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid ACCENT_COLOR;
}

/* ==================== DATE & TIME EDITS ==================== */
QDateEdit, QTimeEdit {
    background-color: #1F1F1F;
    color: #E5E7EB;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 6px 38px 6px 10px;
    font-size: 18pt;
    min-height: 55px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    background: #3F3F3F;
    border-left: 1px solid #5A5A5A;
    border-radius: 4px;
}

QDateEdit::down-arrow {
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 8px solid #CCCCCC;
}

QTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 28px;
    height: 28px;
}

QTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 28px;
    height: 28px;
}

QTimeEdit::up-arrow {
    width: 14px;
    height: 14px;
}

QTimeEdit::down-arrow {
    width: 14px;
    height: 14px;
}

/* ==================== CALENDAR WIDGET ==================== */
QCalendarWidget {
    background-color: #121212;
    color: #E5E7EB;
}

QCalendarWidget QWidget {
    alternate-background-color: #1F1F1F;
}

QCalendarWidget QAbstractItemView {
    background-color: #121212;
    color: #E5E7EB;
    selection-background-color: ACCENT_COLOR;
    selection-color: #121212;
}

QCalendarWidget QToolButton {
    background-color: #1F1F1F;
    color: #E5E7EB;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 8px;
    min-width: 48px;
    min-height: 48px;
    font-size: 18pt;
    font-weight: bold;
}

QCalendarWidget QToolButton:hover {
    background-color: ACCENT_COLOR;
    color: #121212;
    border: 1px solid ACCENT_COLOR;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

QCalendarWidget QMenu {
    background-color: #1F1F1F;
    color: #E5E7EB;
}

QCalendarWidget QSpinBox {
    background-color: #1F1F1F;
    color: #E5E7EB;
    selection-background-color: ACCENT_COLOR;
    selection-color: #121212;
}

/* ==================== GROUPBOX ==================== */
QGroupBox {
    color: #E5E7EB;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding-top: 16px;
    margin-top: 12px;
    font-weight: bold;
    font-size: 14pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0px 12px;
    color: ACCENT_COLOR;
}

/* ==================== INPUT GRAPH ==================== */
InputGraph QLabel {
    font-size: 14pt;
}

InputGraph QDoubleSpinBox,
InputGraph QSpinBox {
    font-size: 14pt;
    min-width: 90px;
    padding-right: 6px;
    min-height: 56px;
}

QPushButton#btnInputGraphClear {
    background-color: #d9534f;
    color: white;
    border: none;
    border-radius: 25px;
    font-size: 20px;
    font-weight: bold;
}

/* ==================== SMARTDOT CHECKBOX COLORS ==================== */
/* QCheckBox#chkXL_X { color: #ff0000; }
QCheckBox#chkXL_Y { color: #00aa00; }
QCheckBox#chkXL_Z { color: #0000ff; }
QCheckBox#chkGL_X { color: #00ffff; }
QCheckBox#chkGL_Y { color: #ff00ff; }
QCheckBox#chkGL_Z { color: #ffff00; }
QCheckBox#chkMG_X { color: #008080; }
QCheckBox#chkMG_Y { color: #800000; }
QCheckBox#chkMG_Z { color: #800080; }
QCheckBox#chkLight { color: #777777; } */

/* ==================== OVERRIDE MODE MAIN WINDOW ==================== */
QMainWindow[override="true"] {
    background-color: #4a0a0a;
}

QMainWindow[override="true"] QWidget {
    background-color: #3a0a0a;
    color: #f4e9e9;
}

QMainWindow[override="true"] #wgtCentral,
QMainWindow[override="true"] #wgtSpacer,
QMainWindow[override="true"] #swPages {
    background-color: #4a0a0a;
}

QMainWindow[override="true"] QFrame,
QMainWindow[override="true"] QGroupBox {
    background-color: #2e0a0a;
    border: 1px solid #6a1a1a;
}

QMainWindow[override="true"] QGroupBox::title {
    color: #ffb3b3;
}

QMainWindow[override="true"] QMenuBar,
QMainWindow[override="true"] QMenu {
    background-color: #3a0a0a;
    color: #f4e9e9;
    border-color: #6a1a1a;
}

QMainWindow[override="true"] QMenuBar::item:selected,
QMainWindow[override="true"] QMenu::item:selected {
    background-color: #ff4d4d;
    color: #1a0a0a;
}

QMainWindow[override="true"] QPushButton {
    background-color: #5a0f0f;
    color: #f4e9e9;
    border: 1px solid #7a1f1f;
}

QMainWindow[override="true"] QPushButton:hover {
    background-color: #6a1414;
    border: 1px solid #ff6b6b;
}

QMainWindow[override="true"] QLineEdit,
QMainWindow[override="true"] QTextEdit,
QMainWindow[override="true"] QPlainTextEdit,
QMainWindow[override="true"] QSpinBox,
QMainWindow[override="true"] QDoubleSpinBox,
QMainWindow[override="true"] QComboBox,
QMainWindow[override="true"] QDateEdit,
QMainWindow[override="true"] QTimeEdit {
    background-color: #4a0f0f;
    color: #f4e9e9;
    border: 1px solid #7a1f1f;
}

QMainWindow[override="true"] QSlider::groove:horizontal {
    background-color: #5a1414;
}

QMainWindow[override="true"] QSlider::handle:horizontal {
    background-color: #ff4d4d;
    border: 1px solid #7a1f1f;
}

QMainWindow[override="true"] QStatusBar {
    background-color: #3a0a0a;
    color: #f4e9e9;
    border-top: 1px solid #6a1a1a;
}

QMainWindow[override="true"] PlotWidget {
    background-color: #121212;
    color: #E5E7EB;
}

QMainWindow[override="true"] #wgtCentral,
QMainWindow[override="true"] #wgtSpacer,
QMainWindow[override="true"] #swPages,
QMainWindow[override="true"] #pageFrontPage,
QMainWindow[override="true"] #pageDiagnosticMode,
QMainWindow[override="true"] #pageShotMode,
QMainWindow[override="true"] #pageAnalysisModePage,
QMainWindow[override="true"] #pageCloudTest,
QMainWindow[override="true"] #pagePlaceHolder,
QMainWindow[override="true"] #pageShotViewPage,
QMainWindow[override="true"] #pageDataViewPage {
    background-color: #cc0000;
}
